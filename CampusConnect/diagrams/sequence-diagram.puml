@startuml sequence-diagram
title CampusConnect - Sequence Diagrams (State, Conflict Detection, Observer, & Builder Patterns)
autonumber
skinparam responseMessageBelowArrow true

== Flow 1: Timetable Scheduling & Mathematical Interval Conflict Detection ==

actor "Admin" as admin
boundary "TimetableGrid (React)" as ttUi
control "TimetableController" as ttController
participant "TimetableService" as ttService
participant "TimetableRepository" as ttRepo
database "PostgreSQL DB" as db

admin -> ttUi : Schedule Course (Monday 09:00 - 10:30, LH-101)
activate ttUi
ttUi -> ttController : POST /api/v1/timetable
activate ttController
ttController -> ttService : scheduleTimetableEntry(request)
activate ttService

ttService -> ttRepo : findClassroomConflicts(roomId, day, 09:00, 10:30)
activate ttRepo
note right of ttRepo: Checks interval intersection: [A.start < B.end] && [A.end > B.start]
ttRepo --> ttService : emptyList() (Room is available)
deactivate ttRepo

ttService -> ttRepo : findFacultyConflicts(facultyId, day, 09:00, 10:30)
activate ttRepo
ttRepo --> ttService : emptyList() (Faculty is free)
deactivate ttRepo

ttService -> ttRepo : save(new TimetableEntry(...))
activate ttRepo
ttRepo -> db : INSERT into timetables
db --> ttRepo : saved
ttRepo --> ttService : savedEntry
deactivate ttRepo

ttService --> ttController : TimetableResponse
deactivate ttService
ttController --> ttUi : 201 Created (TimetableEntry JSON)
deactivate ttController
ttUi --> admin : Show scheduled slot on weekly grid
deactivate ttUi

== Flow 2: Grade Publication & Observer Pattern Persistent Notification ==

actor "Faculty" as facultyUser
boundary "GradeEntry (React)" as gradeUi
control "GradeController" as gradeController
participant "GradeServiceImpl" as gradeService
participant "GradingStrategyFactory" as stratFactory
participant "RelativeGradingStrategy" as relStrategy
participant "ApplicationEventPublisher" as eventPub
participant "AcademicEventListener" as obsListener
participant "NotificationService" as notifService

facultyUser -> gradeUi : Submit Assessment Marks (Relative Bell Curve)
activate gradeUi
gradeUi -> gradeController : POST /api/v1/grades
activate gradeController
gradeController -> gradeService : recordGrade(request)
activate gradeService

gradeService -> stratFactory : getStrategy(RELATIVE)
activate stratFactory
stratFactory --> gradeService : relStrategy
deactivate stratFactory

gradeService -> relStrategy : calculateGrade(marks, maxMarks)
activate relStrategy
note right of relStrategy: Computes Normal Distribution Z-Score\nZ = (X - μ) / σ
relStrategy --> gradeService : GradingResult (letterGrade='A', gradePoint=4.0)
deactivate relStrategy

gradeService -> eventPub : publishEvent(new GradePublishedEvent(...))
activate eventPub
eventPub -> obsListener : onGradePublished(event)
activate obsListener

obsListener -> notifService : sendNotification(studentUserId, "Grade Published", ...)
activate notifService
notifService -> db : INSERT into notifications (is_read=false)
db --> notifService : saved
notifService --> obsListener : notification
deactivate notifService
deactivate obsListener
deactivate eventPub

gradeService --> gradeController : GradeResponse
deactivate gradeService
gradeController --> gradeUi : 200 OK
deactivate gradeController
gradeUi --> facultyUser : Display Grade Confirmation
deactivate gradeUi

== Flow 3: GoF Builder Pattern Academic Transcript Assembly ==

actor "Student" as studentUser
boundary "OfficialTranscriptModal (React)" as transUi
control "TranscriptController" as transController
participant "TranscriptService" as transService
participant "TranscriptDirector" as director
participant "ConcreteTranscriptBuilder" as builder
participant "AcademicTranscriptReport" as report

studentUser -> transUi : Click "Generate Official Transcript"
activate transUi
transUi -> transController : GET /api/v1/transcripts/my-transcript
activate transController
transController -> transService : generateTranscript(studentId)
activate transService

transService -> director : constructTranscript(student, enrollments, grades)
activate director

director -> builder : reset()
activate builder
director -> builder : buildStudentInfo(student)
director -> builder : addCourseRecord(courseRecord)
note right of builder: Formats grade points, weighted GPA, credits
director -> builder : buildAcademicSummary(earnedCredits, gpa, standing)
director -> builder : buildOfficialSignature(registrarName, sealId)
director -> builder : getResult()
builder --> director : report
deactivate builder

director --> transService : report
deactivate director
transService --> transController : report
deactivate transService
transController --> transUi : 200 OK (Official Transcript JSON)
deactivate transController
transUi --> studentUser : Display Credentialed Watermarked Transcript with Print & Verification Seal
deactivate transUi

@enduml
